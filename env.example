# AI provider selection
# Choose one provider: "groq", "gemini", "openai", or "github"
LLM_PROVIDER="groq"

# Optional model overrides
# OpenAI model to use when LLM_PROVIDER is set to "openai"
OPENAI_MODEL="gpt-4o-mini"
# GitHub model to use when LLM_PROVIDER is set to "github"
GITHUB_MODEL="openai/gpt-4.1-mini"

# API keys required by the selected provider
# Groq: https://console.groq.com/keys
GROQ_API_KEY="your_groq_api_key_here"

# Google Gemini: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY="your_google_api_key_here"

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# GitHub Models: https://github.com/settings/tokens
GITHUB_TOKEN="your_github_token_here"
